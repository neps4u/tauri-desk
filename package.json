{
  "name": "tauri-desk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tauri-desk/reference dev",
    "build": "pnpm --filter @tauri-desk/reference build",
    "preview": "pnpm --filter @tauri-desk/reference preview",
    "tauri": "pnpm --filter @tauri-desk/reference tauri",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,svelte,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,svelte,json,md,css}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-eslint-parser": "^1.9.0",
    "typescript-eslint": "^8.71.2"
  }
}
