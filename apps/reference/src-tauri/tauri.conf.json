{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Desk",
  "version": "0.1.0",
  "identifier": "com.tauridesk.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tauri Desk",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://example.com/updates/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "REPLACE_WITH_YOUR_TAURI_SIGNING_PUBLIC_KEY"
    }
  }
}
