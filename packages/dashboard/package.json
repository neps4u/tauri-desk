{
  "name": "@tauri-desk/dashboard",
  "version": "0.1.0",
  "description": "Shared dashboard shell, theming and settings for Tauri 2 + Svelte 5 apps.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "tauri",
    "svelte",
    "dashboard",
    "desktop",
    "svelte5"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neps4u/tauri-desk.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://github.com/neps4u/tauri-desk/tree/main/packages/dashboard#readme",
  "bugs": {
    "url": "https://github.com/neps4u/tauri-desk/issues"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/lib/index.ts",
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": {
      "development": "./src/lib/theme/theme.css",
      "default": "./dist/theme/theme.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "prepack": "pnpm build",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "publint": "publint",
    "attw": "attw --pack . --exclude-entrypoints ./theme.css --ignore-rules internal-resolution-error cjs-resolves-to-esm"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "svelte-spa-router": "^5.1.1",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte2tsx": "^0.7.62",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
